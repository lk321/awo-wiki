{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "lib": ["es2023", "dom", "dom.iterable"],
    "paths": { "phaser": ["./src/types/phaser.d.ts"] },
    "baseUrl": "."
  },
  "include": [".astro/types.d.ts", "src/**/*", "scripts/**/*"],
  "exclude": ["dist"]
}
